# انسخ الملف ده لاسمه .env وحط قيمك جواه

# توكن البوت من @BotFather (إجباري)
BOT_TOKEN=ضع_التوكن_هنا

# آيديات الأدمنز مفصولة بفاصلة (هات الآيدي من @userinfobot)
ADMIN_IDS=

# أقصى حجم للملف بالميجابايت (تليجرام حده 50 للبوتات)
MAX_FILE_MB=48

# حماية من السبام: أقصى طلبات في نافذة زمنية
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=30

# أقصى عدد تحميلات في نفس الوقت
MAX_CONCURRENT=3

# ملف كوكيز اختياري لانستجرام/فيسبوك الخاص (صيغة Netscape)
# COOKIES_FILE=cookies.txt
